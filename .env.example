# Copiá este archivo como ".env" y completá los valores. Nunca subas ".env" al repositorio.

# Clave secreta de la aplicación: una frase larga y aleatoria (por ejemplo, 50 caracteres).
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
# Contraseña de la base de datos PostgreSQL.
DB_PASSWORD=cambiar-por-una-contrasena-segura
# 0 en producción (nunca 1 en un servidor accesible desde internet).
DEBUG=0
# Dirección(es) por la que se entra a la aplicación, separadas por coma.
ALLOWED_HOSTS=gestion.valpob.com.ar,localhost
CSRF_TRUSTED_ORIGINS=https://gestion.valpob.com.ar
# Poné 0 sólo si todavía no tenés HTTPS configurado (por ejemplo, en una red interna).
COOKIES_SEGURAS=1
# Puerto de la computadora/servidor donde queda publicada la aplicación.
PUERTO=8000
